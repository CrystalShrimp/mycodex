config/settings_*.json

# Local/personal config (machine-specific paths, runtime state, generated)
config/shortcuts.json
config/claude_settings.json
config/active_profile

# Logs & runtime output
*.log
logs/
/fed_rate_*.html

# Session persistence
.sessions/

# Windows Zone.Identifier
*.Zone.Identifier

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# User personal notes (report.md is customer-facing — keep trackable)
doc/*
!doc/report.md

# Feishu setup runtime artifacts and credentials
auto_feishu/feishu-app-result.json
auto_feishu/artifacts/
auto_feishu/node_modules/
