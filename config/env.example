# ===== Feishu App Config =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=

# ===== 企业微信渠道（可选，留空不启用）=====
# WECOM_BOT_ID=
# WECOM_SECRET=
# 通道选择：留空 = 自动探测（有飞书凭据启飞书、有企微凭据启企微）；
# 显式逗号列表 = 只启列出的（feishu,wecom）
# CHANNELS=feishu

# ===== Agent Config =====
# Codex 认证使用本机 ChatGPT 登录态（~/.codex/auth.json），无需 API Key。
# codex 不在 PATH 时可设 CODEX_CLI_PATH 指向绝对路径。
CODEX_CLI_PATH=codex
DEFAULT_WORKSPACE=D:\projects\demo

# ===== Approval Config =====
APPROVAL_TIMEOUT=600
# 默认执行模式: h=🛡️严格(只读沙箱) m=⚖️平衡(写入限工作区) l=⚡全自动(无沙箱)
APPROVAL_MODE=m

# ===== Access Control =====
# 飞书访问白名单（飞书 open_id，逗号分隔；留空 = 飞书全员可用）
ALLOWED_USERS=ou_xxxxxxxxxxxxxxxx,ou_xxxxxxxxxxxxxxxx
# 企业微信访问白名单（企业微信 userid，逗号分隔；留空 = 企微全员可用）
WECOM_ALLOWED_USERS=
# 访问模式：creator=仅创建人 | org=企业全员 | groups=指定群成员 | list=指定人员
# 留空 = 默认名单行为（ALLOWED_USERS 空=全员，非空=名单）
# ALLOWED_MODE=list
# ALLOWED_CREATOR=
# ALLOWED_GROUP_IDS=oc_xxxxxxxxxxxxxxxx

# ===== Audit Config =====
AUDIT_LOG_PATH=./logs/audit.log

# ===== Server Config =====
HOST=0.0.0.0
PORT=8090
INSTANCE_LOCK_PORT=48922
