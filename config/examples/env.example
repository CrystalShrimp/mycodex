# ===== Feishu App Config =====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=

# ===== WeCom 智能机器人（企业微信，长连接模式）=====
# 管理后台 → 管理工具 → 智能机器人 → 创建 → 开启 API 模式(长连接) 后获取
# 运行向导选择"企业微信"可交互配置并实测连通
WECOM_BOT_ID=
WECOM_SECRET=

# ===== 通道选择 =====
# 留空 = 自动探测（配置了 FEISHU_APP_ID 启用飞书，配置了 WECOM_BOT_ID 启用企微）
# 显式指定：feishu / wecom / feishu,wecom
CHANNELS=

# ===== Agent Config =====
# Codex 认证使用本机 ChatGPT 登录态（~/.codex/auth.json），无需 API Key。
# codex 不在 PATH 时可设 CODEX_CLI_PATH 指向绝对路径。
CODEX_CLI_PATH=codex
# 初始运行目录：初始任务临时在此运行，后续可用 /cd 命令切换至目标目录（留空默认当前项目下的 workspace 独立沙盒目录）
DEFAULT_WORKSPACE=./workspace
# Codex 历史会话目录：读取电脑端的历史会话（留空默认自动探测 ~/.codex/sessions）
CODEX_SESSION_DIR=

# ===== Approval Config =====
APPROVAL_TIMEOUT=600
# 默认执行模式: h=🛡️严格(只读沙箱) m=⚖️平衡(写入限工作区) l=⚡全自动(无沙箱)
APPROVAL_MODE=m

# ===== Access Control =====
# 飞书访问白名单（飞书 open_id，逗号分隔；留空 = 飞书全员可用）
# 个人用模式配置成功后会自动写入应用创建者的 open_id（名单里明确仅本人可用）
ALLOWED_USERS=
# 企业微信访问白名单（企业微信 userid，逗号分隔；留空且 WECOM_ALLOWED_CHATS 也留空 = 企微全员可用）
WECOM_ALLOWED_USERS=
# 企业微信特定群白名单（方案 A：授权群 chatid，逗号分隔；群内成员直接可用并自动收录进 WECOM_ALLOWED_USERS）
WECOM_ALLOWED_CHATS=
# 访问模式：creator=仅创建人 | org=企业全员 | groups=指定群成员 | list=指定人员
# 留空 = 默认名单行为（ALLOWED_USERS 空=全员，非空=名单）
# ALLOWED_MODE=list
# ALLOWED_CREATOR=
# ALLOWED_GROUP_IDS=oc_xxxxxxxxxxxxxxxx

# ===== Audit Config =====
AUDIT_LOG_PATH=./logs/audit.log

# ===== Server Config =====
HOST=0.0.0.0
PORT=8090
INSTANCE_LOCK_PORT=48922
